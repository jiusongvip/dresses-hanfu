---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import "../../styles/global.css";

const cards = [
  { href: "/buying/where-to-buy/", title: "Where to Buy Hanfu", desc: "From Taobao to Etsy to local shops: the full landscape of Hanfu channels, international shipping, agents, and delivery times." },
  { href: "/buying/best-brands/", title: "Best Hanfu Brands", desc: "Our editor-tested brand list: Hanfu Story, Nuwa, NewMoonDance, and the top Taobao studios worth knowing." },
  { href: "/buying/beginner/", title: "Beginner's Guide to Buying Hanfu", desc: "Your first purchase, done right: budget, size, style, sellers, and the common mistakes to avoid." },
  { href: "/buying/authentic/", title: "Authentic Hanfu: How to Tell Quality", desc: "How to spot real silk, real craftsmanship, and historically-informed reproduction versus cheap costume." },
  { href: "/buying/budget/", title: "Budget Hanfu Under $100", desc: "The honest guide to getting solid Hanfu under $100 — what to expect, what to avoid, and where to buy." },
];
---
<Layout
  title="Hanfu Buying Guide: Where to Buy & Budget"
  description="Everything about buying Hanfu: where to buy online and in China, best brands, beginner purchases, authentic quality, and budget options."
  canonicalUrl="https://www.dresses-hanfu.com/buying/"
  breadcrumbs={[{ name: "Buying", url: "/buying" }]}
>
  <SiteHeader active="/buying/where-to-buy" />
  <main>
    <article>
      <section class="section" style="padding-bottom: 2rem;">
        <div class="container-narrow">
          <p style="font-size:0.8125rem;color:var(--color-muted);margin-bottom:1rem;"><a href="/" style="color:var(--color-accent);">Home</a> &rsaquo; Hanfu Buying Guides</p>
          <h1>Buying Hanfu: Every Guide in One Place</h1>
          <p class="lead" style="font-size:1.25rem;color:var(--color-muted);margin-top:1.5rem;line-height:1.55;">
            Buying Hanfu means navigating a market that mixes handcrafted silk traditions with budget polyesters and a lot of logistic friction across borders. These guides are our honest, editor-tested recommendations — no fluff, real prices.
          </p>
        </div>
      </section>

      <section class="section" style="padding-top:0;">
        <div class="container-narrow">
          <div class="media-card" style="margin-bottom:2.5rem;">
            <div class="media-card-img">
              <img src="/images/buying-shelf.jpg" srcset="/images/opt/buying-shelf-200w.webp 200w, /images/opt/buying-shelf-400w.webp 400w, /images/opt/buying-shelf-600w.webp 600w" sizes="(max-width: 768px) 100vw, 440px" alt="A wall of Hanfu garments on a shop rack — the kind of selection you navigate when buying Hanfu" width="1000" height="663" loading="lazy" decoding="async">
            </div>
            <div class="media-card-body" style="display:flex;flex-direction:column;justify-content:center;">
              <p style="font-size:0.8125rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:var(--color-accent);margin-bottom:0.5rem;">Buying Hanfu</p>
              <p style="font-size:1.375rem;font-weight:600;font-family:var(--font-display);margin:0;">A market of silk, polyester &amp; cross-border shipping.</p>
              <p style="font-size:0.9375rem;color:var(--color-muted);margin-top:0.75rem;">From handcrafted studios to budget Taobao finds — these guides help you buy well, not blindly.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="section" style="padding-top:0;">
        <div class="container">
          <h2>Every Buying Guide</h2>
          <div class="grid-2" style="max-width:52rem;margin-inline:auto;">
            {cards.map((c) => (
              <a href={c.href} class="vs-card" style="display:block;">
                <h3>{c.title}</h3>
                <p>{c.desc}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    </article>
  </main>
  <SiteFooter />
</Layout>