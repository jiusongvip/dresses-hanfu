---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import "../../styles/global.css";

const cards = [
  { href: "/guides/history/", title: "Hanfu History", desc: "Trace Hanfu from the Yellow Emperor through the Han, Tang, Song, and Ming dynasties to the modern revival." },
  { href: "/guides/meaning/", title: "Hanfu Meaning", desc: "What the term actually means, the philosophy of cut and cloth, and why the collar crosses right over left." },
  { href: "/guides/how-to-wear/", title: "How to Wear Hanfu", desc: "A complete step-by-step dressing sequence — inner layers, robes, belts, accessories, hair, and shoes." },
  { href: "/guides/fabrics/", title: "Hanfu Fabrics", desc: "Silk decision-making: sha, ling, luo, jin, ramie, hemp, cotton, and modern blends, plus seasonal choices." },
  { href: "/guides/colors/", title: "Hanfu Colors", desc: "The color system — red for joy, yellow for emperors, blue for spring — and what your palette says." },
  { href: "/guides/etiquette/", title: "Hanfu Etiquette", desc: "The rules: collar direction, sash ties, when to wear what, and how Hanfu etiquette works in public." },
  { href: "/guides/hairstyles/", title: "Hanfu Hairstyles", desc: "Dynasty signature hairstyles — Tang high buns, Song low coils, Ming crowns — and modern adaptations." },
  { href: "/guides/washing/", title: "How to Wash Hanfu", desc: "Care by fabric: hand-wash silk, machine-wash blends, remove stains, store, and iron without damage." },
  { href: "/guides/sizing/", title: "Hanfu Size Guide", desc: "Chinese vs Western sizing, measuring your body, and the adjustable truth of sash-and-tie construction." },
  { href: "/guides/accessories/", title: "Hanfu Accessories", desc: "A field guide to zan, buyao, fans, pouches, jade, and the complete accessory system." },
];
---
<Layout
  title="Hanfu Guides: History, Meaning, Fabrics, Wearing & Care"
  description="Deep-dive Hanfu guides: history, cultural meaning, fabrics, colors, etiquette, hairstyles, washing, sizing, and accessories. Learn Hanfu properly."
  canonicalUrl="https://www.dresses-hanfu.com/guides/"
  breadcrumbs={[{ name: "Guides", url: "/guides" }]}
>
  <SiteHeader active="/guides/how-to-wear" />
  <main>
    <article>
      <section class="section" style="padding-bottom: 2rem;">
        <div class="container-narrow">
          <p style="font-size:0.8125rem;color:var(--color-muted);margin-bottom:1rem;"><a href="/" style="color:var(--color-accent);">Home</a> &rsaquo; Hanfu Guides</p>
          <h1>Hanfu Guides: Learn Traditional Chinese Clothing the Right Way</h1>
          <p class="lead" style="font-size:1.25rem;color:var(--color-muted);margin-top:1.5rem;line-height:1.55;">
            Below is the complete knowledge base for Hanfu: the history, meaning, fabrics, colors, etiquette, and care that every enthusiast should know — written for international readers new to the tradition.
          </p>
        </div>
      </section>

      <section class="section" style="padding-top:0;">
        <div class="container">
          <h2>All Guides</h2>
          <div class="grid-2" style="grid-template-columns:1fr; max-width:52rem; margin-inline:auto;">
            {cards.map((c) => (
              <a href={c.href} class="vs-card" style="display:block;">
                <h3>{c.title}</h3>
                <p>{c.desc}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    </article>
  </main>
  <SiteFooter />
</Layout>