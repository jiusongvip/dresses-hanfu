---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import StyleRecommender from "../components/StyleRecommender.astro";
import SizeGuide from "../components/SizeGuide.astro";

const LAST_UPDATED = "2026-09-08";
const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "inLanguage": "en",
  "dateModified": LAST_UPDATED,
  "author": { "@type": "Organization", "name": "Hanfu Dress Guide", "url": "https://www.dresses-hanfu.com" },
  "citation": [
    { "@type": "CreativeWork", "name": "Kong Yingda, Chunqiu Zuozhuan Zhengyi — origin of the term Huaxia (华夏)", "url": "https://en.wikipedia.org/wiki/Zuo_zhuan" },
    { "@type": "CreativeWork", "name": "Confucius, The Analects XIV — the right-over-left collar rule", "url": "https://en.wikipedia.org/wiki/Analects" },
    { "@type": "CreativeWork", "name": "China National Silk Museum (Hangzhou) — textile and fabric research", "url": "https://www.chinasilkmuseum.com/" },
    { "@type": "CreativeWork", "name": "The Palace Museum (Beijing) — Ming and Qing court dress collections", "url": "https://www.dpm.org.cn/home.html" },
    { "@type": "CreativeWork", "name": "Wikipedia — Hanfu: dynasty overview and modern revival timeline", "url": "https://en.wikipedia.org/wiki/Hanfu" },
  ],
  "mainEntity": [
    {"@type":"Question","name":"What is a Hanfu dress?","acceptedAnswer":{"@type":"Answer","text":"Hanfu is the traditional clothing of the Han Chinese people, characterized by cross-collars, wide sleeves, and flowing robes layered with sashes. It spans over 3,000 years of history and is experiencing a global revival among enthusiasts of all backgrounds."}},
    {"@type":"Question","name":"Can foreigners wear Hanfu?","acceptedAnswer":{"@type":"Answer","text":"Absolutely. Hanfu is meant to be shared and appreciated. Many Hanfu communities worldwide welcome enthusiasts of all backgrounds, and cultural appreciation is encouraged when done respectfully."}},
    {"@type":"Question","name":"Is Hanfu different from a kimono?","acceptedAnswer":{"@type":"Answer","text":"Yes. Hanfu predates the kimono by centuries, using cross-collar wrapping and sash-secured robes with flowing sleeves. Kimonos feature a wide obi belt, T-shaped rectangular construction, and a more rigid silhouette."}},
    {"@type":"Question","name":"What dynasty is Hanfu from?","acceptedAnswer":{"@type":"Answer","text":"Hanfu originates from the Han Dynasty (206 BCE-220 CE), but the term broadly covers traditional Han Chinese clothing from the Yellow Emperor era through the Ming Dynasty (1644 CE). Each dynasty developed distinct styles."}},
    {"@type":"Question","name":"How much does Hanfu cost?","acceptedAnswer":{"@type":"Answer","text":"Entry-level Hanfu starts around $40-80 USD for simple cotton pieces. Mid-range sets range from $100-300 USD. Premium custom-made, historically accurate silk Hanfu can cost $500-2,000+ USD depending on craftsmanship."}},
    {"@type":"Question","name":"Can Hanfu be worn daily?","acceptedAnswer":{"@type":"Answer","text":"Modern Hanfu (xin hanfu) is designed for everyday wear with simplified construction, comfortable breathable fabrics, and practical silhouettes. Traditional ceremonial Hanfu is better suited for festivals, weddings, and special occasions."}},
    {"@type":"Question","name":"Where can I buy authentic Hanfu?","acceptedAnswer":{"@type":"Answer","text":"Reputable sellers include Hanfu Story, NewMoonDance, Nuwa Hanfu, and curated Etsy shops. Always check reviews, material composition, and size charts before purchasing. For authentic Chinese sellers, Taobao and Xianyu offer the widest selection."}},
    {"@type":"Question","name":"What size Hanfu should I get?","acceptedAnswer":{"@type":"Answer","text":"Hanfu sizing follows Chinese measurements, which often run smaller than Western sizes. Always measure your bust, waist, hips, and height, then consult the seller's specific size chart. Many Hanfu pieces are adjustable thanks to sash-and-tie construction."}},
    {"@type":"Question","name":"How do I wash Hanfu?","acceptedAnswer":{"@type":"Answer","text":"Silk Hanfu should be hand-washed in cold water with mild detergent or dry cleaned. Cotton and polyester-blend Hanfu can usually be machine-washed on a gentle cycle in a mesh bag. Always air dry flat and iron on low heat."}},
    {"@type":"Question","name":"What accessories go with Hanfu?","acceptedAnswer":{"@type":"Answer","text":"Traditional accessories include hairpins (zan), jade pendants, decorative fans, embroidered sachets, tassels, and waist ornaments. The choice depends on the dynasty style, occasion, and season."}},
    {"@type":"Question","name":"What is the difference between Hanfu and Qipao?","acceptedAnswer":{"@type":"Answer","text":"Hanfu is loose-fitting, layered, and has roots stretching back thousands of years. Qipao (cheongsam) is a form-fitting, 20th-century dress originating in 1920s Shanghai, influenced by Manchu qizhuang clothing and Western tailoring techniques."}},
    {"@type":"Question","name":"Can I wear Hanfu to a wedding?","acceptedAnswer":{"@type":"Answer","text":"Absolutely, Hanfu is becoming increasingly popular for weddings, both in China and internationally. Red is the traditional bridal color symbolizing joy and prosperity. Many couples now opt for Tang or Ming dynasty-style wedding Hanfu."}},
    {"@type":"Question","name":"How to choose your first Hanfu?","acceptedAnswer":{"@type":"Answer","text":"Start with a simple modern Hanfu (xin hanfu) in cotton or linen for everyday wear. Choose a versatile color like navy, black, or soft pastel. The Ming dynasty style is beginner-friendly because of its structured cuts and adjustable waist ties."}},
    {"@type":"Question","name":"What is modern Hanfu?","acceptedAnswer":{"@type":"Answer","text":"Modern Hanfu (xin hanfu or 'new Hanfu') adapts traditional Hanfu elements for contemporary life. It uses simplified cuts, machine-washable fabrics, and practical silhouettes that work with modern accessories while retaining the cross-collar and layered aesthetic."}},
    {"@type":"Question","name":"Can I rent Hanfu when visiting China?","acceptedAnswer":{"@type":"Answer","text":"Yes, Hanfu rental shops are common in major tourist cities like Xi'an, Hangzhou, Beijing, Suzhou, Chengdu, and Luoyang. Rentals cost 100-300 RMB ($14-42 USD) per day and often include basic hairstyling. Many shops near scenic areas also offer full photography packages (300-800 RMB) with edited photos delivered within 24 hours."}}
  ],
});
const howToSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Wear Hanfu",
  "description": "A step-by-step guide to dressing in traditional Hanfu, from inner layers to final accessories.",
  "inLanguage": "en",
  "datePublished": "2026-08-01",
  "dateModified": LAST_UPDATED,
  "author": { "@type": "Organization", "name": "Hanfu Dress Guide", "url": "https://www.dresses-hanfu.com" },
  "citation": { "@type": "CreativeWork", "name": "Confucius, The Analects XIV — 'Were it not for Guan Zhong, we would be folding our robes to the left'", "url": "https://en.wikipedia.org/wiki/Analects" },
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Inner Layer (Zhongyi)",
      "text": "Start with a white cotton or silk inner garment worn against the skin. Cross the collar right over left, securing it with an inner tie."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Main Robe (Aoqun or Ruqun)",
      "text": "Layer the main outer garment. Always cross the collar right over left -- left over right is reserved for funerals in Chinese tradition."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Belt and Sash",
      "text": "Secure the waist with a fabric sash or decorative belt. Silk ribbons or leather belts both work, depending on the dynasty style."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "name": "Accessories",
      "text": "Add hairpins (zan), jade pendants, decorative fans, tassels, and other ornaments. Choose pieces that complement your chosen dynasty style."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "name": "Hair and Footwear",
      "text": "Style hair in a traditional updo, braid, or half-up style. Finish with embroidered cloth shoes or boots."
    }
  ],
});
---
<Layout
  title="Traditional Chinese Hanfu: Complete 2026 Guide"
  description="Discover authentic Hanfu dresses: styles by dynasty, how-to-wear guides, outfit inspiration, trusted buying recommendations. Your complete hanfu dress resource."
>

  <nav class="nav" role="navigation" aria-label="Main navigation">
    <div class="nav-inner">
      <a href="/" class="nav-logo" aria-label="Hanfu Dress Guide home">Hanfu Dress Guide</a>
      <div class="nav-links">
        <a href="#styles">Styles</a>
        <a href="#dynasties">Dynasties</a>
        <a href="#how-to-wear">How to Wear</a>
        <a href="#vs">Comparisons</a>
        <a href="#buy">Buying Guide</a>
        <a href="#travel">Travel</a>
        <a href="#faq">FAQ</a>
      </div>
      <a href="/travel/xian/" class="btn btn-primary" style="padding: 0.5rem 1.25rem; font-size: 0.875rem;">Wear It in China</a>
    </div>
  </nav>

  <main>

    <!-- Hero -->
    <section class="hero" aria-labelledby="hero-heading">
      <div class="container">
        <div class="hero-grid">
          <div class="hero-content">
        <h1 id="hero-heading">Hanfu Dresses — The Complete Guide</h1>
            <p class="lead">Flowing robes, 3,000 years, &amp; one unforgettable look. Everything about traditional Chinese Hanfu — the visual way.</p>
            <p style="font-size:0.8125rem;color:var(--color-muted);margin:1rem 0 0;">Curated and fact-checked by the <strong>Hanfu Dress Guide Editorial Team</strong> · Last updated <time datetime="2026-09-08">September 8, 2026</time></p>
            <div class="hero-cta-group">
              <a href="#styles" class="btn btn-primary">Explore Styles</a>
              <a href="#buy" class="btn btn-outline">Buying Guide</a>
            </div>
          </div>
          <div class="hero-image">
            <img src="/images/hero-hanfu-dress.webp" srcset="/images/opt/hero-hanfu-dress-400w.webp 400w, /images/opt/hero-hanfu-dress-600w.webp 600w" sizes="(max-width: 768px) 100vw, 480px" alt="Woman wearing elegant Tang Dynasty red Hanfu dress with flowing wide sleeves in ancient Chinese palace courtyard" width="600" height="800" fetchpriority="high" loading="eager" decoding="sync">
          </div>
        </div>
      </div>
    </section>

    <!-- What is Hanfu + Can I wear — full-bleed image band -->
    <section class="section" style="padding-top: 4rem;" aria-label="What is Hanfu">
      <div class="image-band image-band-full">
        <img src="/images/hanfu-og.webp" srcset="/images/opt/hanfu-og-400w.webp 400w, /images/opt/hanfu-og-600w.webp 600w" sizes="100vw" alt="Graceful Hanfu robe with flowing sleeves and traditional crossed collar" width="1200" height="630" loading="lazy">
        <div class="image-band-caption">
          <span class="band-kicker">Hanfu 101</span>
          <span class="band-title">Cross-collar robes. Sash-tied. Right over left.</span>
          <span class="band-sub">That's the whole shape of Hanfu. Every body can wear it — anyone, any size.</span>
          <div class="band-cta">
            <a href="/guides/history/" class="btn btn-outline">3,000 Year History</a>
          </div>
        </div>
      </div>

      <div class="container" style="max-width:52rem;margin-top:3rem;">
        <blockquote style="margin:0;padding:1.5rem 2rem;border-left:3px solid var(--color-accent);background:rgba(255,255,255,0.04);border-radius:0.75rem;">
          <p style="margin:0;font-size:1.0625rem;line-height:1.7;font-family:var(--font-display);">&ldquo;The Middle Kingdom has the grandeur of rites and etiquette, hence it is called Xia; it has the beauty of robes and garments, hence it is called Hua.&rdquo;</p>
          <p style="margin:0.5rem 0 0;font-size:0.9375rem;color:var(--color-muted);">&ldquo;中国有礼仪之大，故称夏；有服章之美，谓之华。&rdquo;</p>
          <footer style="margin-top:1rem;font-size:0.8125rem;color:var(--color-muted);">
            — Kong Yingda (孔颖达, 574&ndash;648 CE), <cite style="font-style:normal;">Chunqiu Zuozhuan Zhengyi</cite>, commentary on the <a href="https://en.wikipedia.org/wiki/Zuo_zhuan" rel="noopener" target="_blank" style="color:var(--color-accent);">Zuo Zhuan</a>. The origin of the phrase &ldquo;Huaxia&rdquo; (华夏) as China's poetic name.
          </footer>
        </blockquote>
        <blockquote style="margin:1.25rem 0 0;padding:1.5rem 2rem;border-left:3px solid var(--color-accent);background:rgba(255,255,255,0.04);border-radius:0.75rem;">
          <p style="margin:0;font-size:1.0625rem;line-height:1.7;font-family:var(--font-display);">&ldquo;Were it not for Guan Zhong, we would be wearing our hair unbound and folding our robes to the left.&rdquo;</p>
          <p style="margin:0.5rem 0 0;font-size:0.9375rem;color:var(--color-muted);">&ldquo;微管仲，吾其被发左衽矣。&rdquo;</p>
          <footer style="margin-top:1rem;font-size:0.8125rem;color:var(--color-muted);">
            — Confucius, <a href="https://en.wikipedia.org/wiki/Analects" rel="noopener" target="_blank" style="color:var(--color-accent);"><cite style="font-style:normal;">The Analects</cite></a>, XIV. The right-over-left collar rule on this page traces back to this line.
          </footer>
        </blockquote>
      </div>

      <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:0.6rem;margin-top:1.5rem;">
        <span class="chip"><i class="fa-solid fa-rotate-left"></i> right-over-left collar</span>
        <span class="chip"><i class="fa-solid fa-shirt"></i> wide sleeves</span>
        <span class="chip"><i class="fa-solid fa-link"></i> sash, not buttons</span>
        <span class="chip"><i class="fa-solid fa-hands"></i> for every body type</span>
      </div>
    </section>

    <!-- Explore Styles -->
    <section id="styles" class="section" aria-labelledby="styles-heading">
      <div class="container">
        <div class="section-head section-title-margin">
          <span class="section-head-icon"><i class="fa-solid fa-landmark"></i></span>
          <h2 id="styles-heading" class="section-title" style="margin-bottom:0;">Explore Hanfu Styles</h2>
        </div>
        <div class="media-card" style="margin-bottom: 2rem; grid-template-columns: 38% 62%;">
          <div class="media-card-img">
            <img src="/images/pexels-ginkgo.jpg" srcset="/images/opt/pexels-ginkgo-400w.webp 400w, /images/opt/pexels-ginkgo-600w.webp 600w" sizes="(max-width: 768px) 100vw, 420px" alt="Woman wearing traditional Chinese Hanfu amidst fallen ginkgo leaves" width="1600" height="2400" loading="lazy">
          </div>
          <div class="media-card-body" style="display:flex;flex-direction:column;justify-content:center;">
            <h3>8 styles. One fabric world.</h3>
            <p>Dynasty classics, modern everyday wear, and wedding robes. Tap a style to see it up close.</p>
            <div class="chip-row" style="margin-top:1rem;">
              <span class="chip"><i class="fa-solid fa-fire"></i> Tang drama</span>
              <span class="chip"><i class="fa-solid fa-leaf"></i> Song calm</span>
              <span class="chip"><i class="fa-solid fa-tshirt"></i> Modern easy</span>
            </div>
          </div>
        </div>
        <div class="grid-3">
<a href="/styles/tang/" class="style-link"><span class="style-link-icon"><i class="fa-solid fa-fire"></i></span><div><strong>Tang Dynasty</strong><span class="card-desc">Bold. Big sleeves.</span></div></a>
          <a href="/styles/song/" class="style-link"><span class="style-link-icon"><i class="fa-solid fa-leaf"></i></span><div><strong>Song Dynasty</strong><span class="card-desc">Quiet. Soft tones.</span></div></a>
          <a href="/styles/ming/" class="style-link"><span class="style-link-icon"><i class="fa-solid fa-landmark"></i></span><div><strong>Ming Dynasty</strong><span class="card-desc">Structured. Embroidery.</span></div></a>
          <a href="/styles/modern/" class="style-link"><span class="style-link-icon"><i class="fa-solid fa-tshirt"></i></span><div><strong>Modern Xin Hanfu</strong><span class="card-desc">Everyday easy wear.</span></div></a>
          <a href="/styles/wedding/" class="style-link"><span class="style-link-icon"><i class="fa-solid fa-ring"></i></span><div><strong>Wedding Hanfu</strong><span class="card-desc">Red + gold robes.</span></div></a>
          <a href="/styles/women/" class="style-link"><span class="style-link-icon"><i class="fa-solid fa-user-large"></i></span><div><strong>Women's Hanfu</strong><span class="card-desc">Flowing ruqun.</span></div></a>
          <a href="/styles/men/" class="style-link"><span class="style-link-icon"><i class="fa-solid fa-user-tie"></i></span><div><strong>Men's Hanfu</strong><span class="card-desc">Straight, darker cuts.</span></div></a>
          <a href="/styles/kids/" class="style-link"><span class="style-link-icon"><i class="fa-solid fa-baby"></i></span><div><strong>Kids Hanfu</strong><span class="card-desc">Soft. Festive-ready.</span></div></a>
        </div>
      </div>
    </section>

    <!-- Dynasties -->
    <!-- Style Recommender Quiz -->
    <StyleRecommender />

        <section id="dynasties" class="section" aria-labelledby="dynasties-heading">
      <div class="container">
        <div class="section-head section-title-margin">
          <span class="section-head-icon"><i class="fa-solid fa-compass"></i></span>
          <h2 id="dynasties-heading" class="section-title" style="margin-bottom:0;">Hanfu by Dynasty</h2>
        </div>
        <p class="section-subtitle-lean">Four eras. Four looks. Tap a dynasty.</p>
        <div class="grid-4">
          <a href="/dynasty/han/" class="dynasty-card" style="display:block;color:inherit;">
            <div class="dynasty-card-img">
              <img src="/images/dynasty-han.webp" srcset="/images/opt/dynasty-han-400w.webp 400w, /images/opt/dynasty-han-600w.webp 600w" sizes="(max-width: 900px) 50vw, 300px" alt="Traditional Han Dynasty shenyi robe with wide sleeves and crossed collar in earthen tones" width="600" height="800" loading="lazy">
            </div>
            <div class="dynasty-card-body">
              <h3>Han Dynasty</h3>
              <p class="era">206 BCE — 220 CE</p>
              <p>Where it all began.</p>
            </div>
          </a>
          <a href="/dynasty/tang/" class="dynasty-card" style="display:block;color:inherit;">
            <div class="dynasty-card-img">
              <img src="/images/dynasty-tang.webp" srcset="/images/opt/dynasty-tang-400w.webp 400w, /images/opt/dynasty-tang-600w.webp 600w" sizes="(max-width: 900px) 50vw, 300px" alt="Tang Dynasty Hanfu dress with bold red and gold colors and dramatic flowing silhouette" width="600" height="800" loading="lazy">
            </div>
            <div class="dynasty-card-body">
              <h3>Tang Dynasty</h3>
              <p class="era">618 — 907 CE</p>
              <p>Big colors. Big sleeves.</p>
            </div>
          </a>
          <a href="/dynasty/song/" class="dynasty-card" style="display:block;color:inherit;">
            <div class="dynasty-card-img">
              <img src="/images/dynasty-song.webp" srcset="/images/opt/dynasty-song-400w.webp 400w, /images/opt/dynasty-song-600w.webp 600w" sizes="(max-width: 900px) 50vw, 300px" alt="Song Dynasty Hanfu with slim silhouette and layered beizi jacket in muted pastel tones" width="600" height="800" loading="lazy">
            </div>
            <div class="dynasty-card-body">
              <h3>Song Dynasty</h3>
              <p class="era">960 — 1279 CE</p>
              <p>Quiet. Refined. Soft.</p>
            </div>
          </a>
          <a href="/dynasty/ming/" class="dynasty-card" style="display:block;color:inherit;">
            <div class="dynasty-card-img">
              <img src="/images/dynasty-ming.webp" srcset="/images/opt/dynasty-ming-400w.webp 400w, /images/opt/dynasty-ming-600w.webp 600w" sizes="(max-width: 900px) 50vw, 300px" alt="Ming Dynasty Hanfu with standing collar and ornate gold embroidery on rich blue brocade" width="600" height="800" loading="lazy">
            </div>
            <div class="dynasty-card-body">
              <h3>Ming Dynasty</h3>
              <p class="era">1368 — 1644 CE</p>
              <p>Structured. Dignified. Rich.</p>
            </div>
          </a>
        </div>
      </div>
    </section>

<!-- Outfit Inspiration -->
    <section id="outfits" class="section" aria-labelledby="outfits-heading">
      <div class="container">
        <div class="section-head section-title-margin">
          <span class="section-head-icon"><i class="fa-solid fa-images"></i></span>
          <h2 id="outfits-heading" class="section-title" style="margin-bottom:0;">Hanfu Outfit Inspiration</h2>
        </div>
        <p class="section-subtitle-lean">From casual daily wear to formal ceremonies and editorial photography.</p>
        <div class="grid-3">
          <div class="gallery-item">
            <img src="/images/outfit-daily.webp" srcset="/images/opt/outfit-daily-400w.webp 400w, /images/opt/outfit-daily-600w.webp 600w" sizes="(max-width: 900px) 50vw, 300px" alt="Modern xin hanfu casual daily wear in cotton linen with cross-collar design" width="600" height="800" loading="lazy">
            <span class="gallery-label">Daily Hanfu</span>
          </div>
          <div class="gallery-item">
            <img src="/images/outfit-festival.webp" srcset="/images/opt/outfit-festival-400w.webp 400w, /images/opt/outfit-festival-600w.webp 600w" sizes="(max-width: 900px) 50vw, 300px" alt="Woman wearing festive Hanfu with elaborate gold embroidery at traditional Chinese lantern festival" width="600" height="800" loading="lazy">
            <span class="gallery-label">Festival</span>
          </div>
          <div class="gallery-item">
            <img src="/images/outfit-wedding.webp" srcset="/images/opt/outfit-wedding-400w.webp 400w, /images/opt/outfit-wedding-600w.webp 600w" sizes="(max-width: 900px) 50vw, 300px" alt="Bridal wedding Hanfu in luxurious red silk with gold phoenix embroidery" width="600" height="800" loading="lazy">
            <span class="gallery-label">Wedding</span>
          </div>
          <div class="gallery-item">
            <img src="/images/outfit-tea-ceremony.webp" srcset="/images/opt/outfit-tea-ceremony-400w.webp 400w, /images/opt/outfit-tea-ceremony-600w.webp 600w" sizes="(max-width: 900px) 50vw, 300px" alt="Woman in Song Dynasty Hanfu performing traditional Chinese tea ceremony in bamboo room" width="600" height="800" loading="lazy">
            <span class="gallery-label">Tea Ceremony</span>
          </div>
          <div class="gallery-item">
            <img src="/images/outfit-photography.webp" srcset="/images/opt/outfit-photography-400w.webp 400w, /images/opt/outfit-photography-600w.webp 600w" sizes="(max-width: 900px) 50vw, 300px" alt="Professional editorial photography of Tang Dynasty Hanfu at ancient temple with misty mountains" width="600" height="800" loading="lazy">
            <span class="gallery-label">Photography</span>
          </div>
          <div class="gallery-item">
            <img src="/images/outfit-cosplay.webp" srcset="/images/opt/outfit-cosplay-400w.webp 400w, /images/opt/outfit-cosplay-600w.webp 600w" sizes="(max-width: 900px) 50vw, 300px" alt="Fantasy-inspired Hanfu cosplay costume with intricate embroidery in mystical forest" width="600" height="800" loading="lazy">
            <span class="gallery-label">Cosplay</span>
          </div>
        </div>
      </div>
    </section>

    <!-- VS Comparisons -->
    <section id="vs" class="section" aria-labelledby="vs-heading">
      <div class="container">
        <div class="section-head section-title-margin">
          <span class="section-head-icon"><i class="fa-solid fa-scale-balanced"></i></span>
          <h2 id="vs-heading" class="section-title" style="margin-bottom:0;">Hanfu vs Kimono, Qipao, Hanbok</h2>
        </div>
        <div class="image-band image-band-full" style="margin-bottom: 2.5rem;">
        <img src="/images/pexels-hanfu-bridge.jpg" srcset="/images/opt/pexels-hanfu-bridge-400w.webp 400w, /images/opt/pexels-hanfu-bridge-600w.webp 600w" sizes="100vw" alt="Woman in flowing red Hanfu posing on a bridge against a city skyline" width="1600" height="1065" loading="lazy">
        <div class="image-band-caption">
          <span class="band-kicker">Quick ID</span>
          <span class="band-title">Kimono? Qipao? Hanbok? Here's the difference.</span>
          <span class="band-sub">Three fast comparisons — one glance each.</span>
        </div>
      </div>
        <div class="grid-2" style="max-width: 64rem; margin-inline: auto;">
          <a href="/comparisons/kimono/" class="vs-card" style="display:block;color:inherit;">
            <h3>Hanfu <span style="color:var(--color-muted);">vs</span> Kimono</h3>
            <p>Older by 1,000+ years. Hanfu: sash-tied + cross-collar. Kimono: obi belt + rigid T-shape.</p>
          </a>
          <a href="/comparisons/qipao/" class="vs-card" style="display:block;color:inherit;">
            <h3>Hanfu <span style="color:var(--color-muted);">vs</span> Qipao</h3>
