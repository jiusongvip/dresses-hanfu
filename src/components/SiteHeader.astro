---
const { active } = Astro.props;
const links = [
  { href: "/#styles", label: "Styles" },
  { href: "/#dynasties", label: "Dynasties" },
  { href: "/guides/how-to-wear", label: "Guides" },
  { href: "/comparisons", label: "Comparisons" },
  { href: "/buying/where-to-buy", label: "Buying" },
  { href: "/travel", label: "Travel" },
  { href: "/#faq", label: "FAQ" },
];
---
<nav class="nav" role="navigation" aria-label="Main navigation">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="Hanfu Dress Guide home">Hanfu Dress Guide</a>
    <div class="nav-links">
      {links.map((l) => (
        <a href={l.href} class:list={{ active: active === l.href }}>{l.label}</a>
      ))}
    </div>
    <a href="/travel/xian" class="btn btn-primary" style="padding: 0.5rem 1.25rem; font-size: 0.875rem;">Wear It in China</a>
  </div>
</nav>

<style>
  .nav-links a.active {
    color: var(--color-accent);
  }
</style>